{
	"name": "@dialecte/core",
	"version": "0.8.1",
	"description": "Dialecte - Core functionality for Dialecte SDK",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dialecte/core.git"
	},
	"bin": {
		"dialecte-xmlfmt": "bin/xmlfmt.mjs"
	},
	"source": "src/index.ts",
	"files": [
		"dist",
		"skills",
		"!skills/*/evals",
		"bin"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./test": {
			"types": "./dist/test.d.ts",
			"default": "./dist/test.js"
		},
		"./test/xsd/*": "./dist/test/xsd/*",
		"./utils": {
			"types": "./dist/utils.d.ts",
			"default": "./dist/utils.js"
		},
		"./helpers": {
			"types": "./dist/helpers.d.ts",
			"default": "./dist/helpers.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite.d.ts",
			"default": "./dist/sqlite.js"
		}
	},
	"scripts": {
		"//====== BUILD ======//": "",
		"build": "run-p type-check \"build-only {@}\" --",
		"build-only": "tsc -p tsconfig.json && vite build && vite build -c vite.engine.config.ts",
		"build:watch": "vite build --watch",
		"//====== VITEPRESS ======//": "",
		"doc:dev": "vitepress dev",
		"doc:build": "vitepress build",
		"doc:preview": "vitepress preview",
		"//====== TEST ======//": "",
		"test": "npm run test:node && npm run test:browser",
		"test:node": "vitest run --project node --project node-indexeddb --project node-sqlite",
		"test:browser": "vitest run --project browser",
		"test:browser:all": "vitest run --project browser-all",
		"test:perf": "VITE_BENCH=1 vitest run --project perf --mode bench --reporter=verbose",
		"test:perf:node": "VITE_BENCH=1 vitest run --project perf-node --mode bench --reporter=verbose",
		"test:hook": "dialecte gate --hook",
		"//====== CHECK ======//": "",
		"check": "run-p type-check type-check:test type-check:node lint:check format:check",
		"skills:generate": "dialecte skills generate",
		"skills:check": "dialecte skills check",
		"type-check": "tsc -p tsconfig.build.json --noEmit --skipLibCheck",
		"type-check:test": "tsc -p tsconfig.vitest.json --noEmit",
		"type-check:node": "tsc -p tsconfig.node.json --noEmit",
		"//====== TYPE PERF ======//": "",
		"coverage:gen": "dialecte coverage",
		"type-bench": "npm run coverage:gen && dialecte bench",
		"type-bench:check": "npm run coverage:gen && dialecte bench --check",
		"type-narrowing": "npm run coverage:gen && dialecte narrowing",
		"lint:check": "oxlint --deny-warnings",
		"lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"//====== HOOKS ======//": "",
		"prepare": "husky"
	},
	"dependencies": {
		"@sqlite.org/sqlite-wasm": "3.54.1-build1",
		"@types/sax": "1.2.7",
		"comlink": "4.4.2",
		"dexie": "4.4.6",
		"libxml2-wasm": "0.7.2",
		"sax": "^1.4.3"
	},
	"devDependencies": {
		"@dialecte/cli": "0.3.1",
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^24.12.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser-playwright": "^4.1.10",
		"fake-indexeddb": "^6.2.6",
		"husky": "^9.1.7",
		"jiti": "^2.4.2",
		"mermaid": "11.17.2",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.68.0",
		"oxlint-tsgolint": "^0.23.0",
		"playwright": "^1.60.0",
		"tsx": "^4.23.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.0.16",
		"vite-plugin-dts": "^5.0.2",
		"vitepress": "^2.0.0-alpha.17",
		"vitepress-plugin-llms": "^1.13.2",
		"vitepress-plugin-mermaid": "2.0.17",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"vitepress-plugin-mermaid": {
			"vitepress": "$vitepress"
		}
	},
	"dialecte": {
		"profile": "contributor",
		"tdd": {
			"production": [
				"src/test"
			]
		},
		"gate": {
			"fast": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "skills",
					"run": "npm run skills:check"
				},
				{
					"name": "tests",
					"run": "npx vitest run --changed --project node --project node-indexeddb",
					"counts": "tests",
					"changedOnly": true
				}
			],
			"full": [
				{
					"name": "check",
					"run": "npm run check"
				},
				{
					"name": "skills",
					"run": "npm run skills:check"
				},
				{
					"name": "build",
					"run": "npm run build"
				},
				{
					"name": "tests",
					"run": "npm run test:node",
					"counts": "tests"
				},
				{
					"name": "browser tests",
					"run": "npx vitest run --project browser",
					"counts": "tests"
				}
			]
		}
	}
}
